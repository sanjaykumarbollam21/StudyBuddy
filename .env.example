# ==============================================================================
# STUDY BUDDY - ROOT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

PORT=8000
ENVIRONMENT=production
DEBUG=false

# Security
SECRET_KEY=your-super-secret-jwt-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# SQLite default for local:
# DATABASE_URL=sqlite+aiosqlite:///./study_buddy.db
# PostgreSQL for production:
DATABASE_URL=postgresql+asyncpg://study_buddy_user:password@host:5432/study_buddy
DB_ECHO=false

# AI Providers
AI_MODE=cloud
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

CORS_ORIGINS=["*"]
