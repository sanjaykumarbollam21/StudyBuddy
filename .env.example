# ==========================================
# STUDY BUDDY - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase)
# For local dev without Postgres, backend can fall back to sqlite:///./study_buddy.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/study_buddy
DB_ECHO=False

# Supabase (Optional for Auth, Storage & RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Modes & Privacy (Offline-First Architecture)
AI_MODE=offline
OFFLINE_ONLY=False
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Embedding & Vector Database (Phase 3 & 3.1)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
VECTOR_DISTANCE=cosine
DEFAULT_GROUNDING_MODE=materials_plus_general
VECTOR_STORE_TYPE=pgvector

# Search Engine API (Tavily, Serper, Bing, or DuckDuckGo)
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=your-search-api-key

# Speech & Audio (TTS / STT)
STT_PROVIDER=whisper
TTS_PROVIDER=edge_tts

# Storage (local, supabase, s3)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5000","*"]
