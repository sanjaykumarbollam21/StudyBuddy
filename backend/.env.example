# ==========================================
# STUDY BUDDY - ENVIRONMENT CONFIGURATION
# Cloud-First AI Learning Platform
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=False
APP_SECRET_KEY=generate-a-strong-random-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite+aiosqlite:///./study_buddy.db
DB_ECHO=False

# Supabase (Optional for Auth, Remote Storage & Realtime Sync)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Gateway Architecture (Cloud-First)
# AI_MODE is set to 'cloud' for production LLM operations.
# Mobile clients connect via FastAPI gateway; NO provider API keys are embedded in APK.
AI_MODE=cloud
OFFLINE_ONLY=False
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Cloud Model Configurations
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_FACTOR=1.5

# Embeddings & Vector Search (Document-grounded RAG)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
VECTOR_DISTANCE=cosine
DEFAULT_GROUNDING_MODE=materials_plus_general
VECTOR_STORE_TYPE=pgvector

# Search Engine API for Current Affairs & Fact-Checking
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=your-search-api-key

# Speech & Multimodal Audio
STT_PROVIDER=whisper
TTS_PROVIDER=edge_tts

# Storage (local, supabase, or s3)
STORAGE_TYPE=supabase
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5000","*"]
