# ==============================================================================
# STUDY BUDDY - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and customize values for local development or production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment Settings
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production # development, staging, production
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-jwt-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# Local Development (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./study_buddy.db

# Production (PostgreSQL with asyncpg):
# Render / Railway / Supabase Postgres URL:
DATABASE_URL=postgresql+asyncpg://study_buddy_user:your_password@dpg-xxxxx.oregon-postgres.render.com:5432/study_buddy
DB_ECHO=false

# ------------------------------------------------------------------------------
# 4. AI Gateway & LLM Provider API Keys (Cloud-First)
# ------------------------------------------------------------------------------
# Set the primary tutor provider: gemini, openai, anthropic, groq, mock
AI_MODE=cloud
OFFLINE_ONLY=false
AI_DEFAULT_PROVIDER=gemini

# Google Gemini (Recommended primary provider - generous free tier)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Alternative provider)
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (Alternative provider)
# Obtain at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq Cloud (Ultra-fast Llama-3 inference)
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Network Resilience Settings
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_FACTOR=1.5

# ------------------------------------------------------------------------------
# 5. Embeddings & RAG Vector Search
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=local # local (HuggingFace CPU), gemini, openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
VECTOR_DISTANCE=cosine
DEFAULT_GROUNDING_MODE=materials_plus_general

# ------------------------------------------------------------------------------
# 6. File Storage & Uploads
# ------------------------------------------------------------------------------
STORAGE_TYPE=local # local or supabase
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 7. Supabase Integration (Optional remote storage & auth)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=study-materials

# ------------------------------------------------------------------------------
# 8. CORS Origins (JSON list or comma-separated URLs)
# ------------------------------------------------------------------------------
CORS_ORIGINS=["*"]
